    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "electron-updater": "^6.8.9",
    "ws": "^8.21.0"
  },
  "overrides": {
    "lodash": "^4.17.21",
    "tar": "^7.5.11",
    "@xmldom/xmldom": "^0.8.12",
    "brace-expansion": "^5.0.5"
  }
}
