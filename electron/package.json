{
  "name": "securechat",
  "version": "1.0.4",
  "description": "Privacy-focused messaging with PGP + I2P",
  "homepage": "https://github.com/weedo078/SecuChat",
  "repository": {
    "type": "git",
    "url": "https://github.com/weedo078/SecuChat.git"
  },
  "author": {
    "name": "weedo078",
    "email": "weedo078@users.noreply.github.com"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && electron dist/main.js",
    "dist": "npm run build && electron-builder",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "publish": "npm run build && electron-builder --publish always"
  },
  "build": {
    "appId": "com.secuchat.app",
    "productName": "SecuChat",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../app/dist",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/i2pd",
        "to": "i2pd",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "weedo078",
      "repo": "SecuChat",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.social-networking",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "perMachine": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network;Chat;",
      "icon": "../app/dist"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.5",
    "@types/ws": "^8.5.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.0",
    "electron-updater": "^6.8.3",
    "ws": "^8.18.0"
  }
}
