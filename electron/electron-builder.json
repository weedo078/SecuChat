{
  "appId": "com.securechat.desktop",
  "productName": "SecuChat",
  "directories": {
    "output": "release",
    "buildResources": "build-assets"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.map"
  ],
  "extraResources": [
    {
      "from": "../app/dist",
      "to": "app",
      "filter": ["**/*"]
    },
    {
      "from": "resources/i2pd",
      "to": "i2pd",
      "filter": ["**/*"]
    }
  ],
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["arm64"] }
    ],
    "category": "Network",
    "icon": "build-assets/icon.png"
  },
  "win": {
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "icon": "build-assets/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true
  }
}
